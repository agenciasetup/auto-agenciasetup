// Worker da Agência Setup: site público, downloads, anúncios e conector do Claude (/mcp).
// Segredos (SUPABASE_URL, SUPABASE_SECRET_KEY, OAUTH_SEGREDO, CRIPTO_CHAVE e os apps de cada rede) ficam no
// .dev.vars (computador) e em "wrangler secret" (produção). O painel compilado sai em public/admin (npm run painel).
{
  "name": "agenciasetup",
  "main": "worker/index.js",
  "account_id": "0b28679f6c415b4b53336d6adb383623",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    // O Worker atende tudo, menos os arquivos fixos (CSS, JS, imagens).
    "run_worker_first": ["/*", "!/estatico/*", "!/img/*", "!/admin/assets/*", "!/aluno/assets/*"]
  },
  // Domínio próprio: a Cloudflare cria o DNS e o certificado sozinha. Sem endereço *.workers.dev público.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "agenciasetup.com.br", "custom_domain": true },
    { "pattern": "www.agenciasetup.com.br", "custom_domain": true },
    // Área de membros (app do aluno). O Worker decide pelo endereço (worker/index.js).
    { "pattern": "curso.agenciasetup.com.br", "custom_domain": true },
    // Cursos com marca própria (lib/marcas.js): o mesmo Worker, com a cara do curso. Dúvidas da Fé (perfil da Raquel).
    { "pattern": "duvidasdafe.agenciasetup.com.br", "custom_domain": true },
    // O curso em inglês (Posts on Autopilot, em dólar): agenciasetup.com, zona própria no Cloudflare desde 30/10/2026.
    { "pattern": "agenciasetup.com", "custom_domain": true },
    { "pattern": "www.agenciasetup.com", "custom_domain": true }
  ],
  // O despertador do Atendente (Durable Object, incluso no Workers pago): faz a resposta do direct sair uns 20 segundos
  // depois da última mensagem, sem esperar o relógio de minuto. Classe em worker/despertador.js; lógica e explicação em
  // worker/lib/despertador.js. Liga e desliga em config.atendente.na_hora, sem publicar de novo.
  "durable_objects": { "bindings": [{ "name": "DESPERTADOR", "class_name": "Despertador" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Despertador"] }],
  // Relógio: publica o que foi agendado (e, quando as redes forem conectadas, a fila delas).
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  // No computador, o endereço continua localhost (sem isto, o wrangler troca pelo domínio da rota).
  "dev": { "host": "localhost:8787", "upstream_protocol": "http" },
  "vars": {
    "SITE_URL": "https://agenciasetup.com.br",
    "CURSO_URL": "https://curso.agenciasetup.com.br",
    // Asaas de verdade (a chave fica em segredo: ASAAS_CHAVE). No computador, sem a chave, o pagamento é simulado.
    "ASAAS_AMBIENTE": "producao",
    // Workers pago (US$ 5 por mês, assinado em 10/11/2026): o relógio faz mais por vez (nucleo/db.js, lib/relogio.js,
    // lib/gatilhos.js, lib/desempenho.js, lib/radar.js). Os tetos de mensagens para as pessoas não mudam. Não é segredo.
    "WORKERS_PAGO": "1"
  }
}
